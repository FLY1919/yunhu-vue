+<script setup lang="ts">
+import { computed, ref, nextTick, watch } from 'vue'
+import Icon from '../console/components/Icon.vue'
+import { renderMarkdown } from '../core/render'
+import { fixResourceUrls } from '../core/res'
+import { markdownEdit, type CommunityDraft } from '../core/community-drafts'
+const props = defineProps<{ draft: CommunityDraft; busy?: boolean; error?: string; savedAt?: number; detached?: boolean; uploading?: boolean }>()
+const emit = defineEmits(['change', 'save', 'publish', 'close', 'detach', 'upload'])
+const mode = ref('split'), source = ref<HTMLTextAreaElement>(), preview = ref<HTMLElement>(), outlineOpen = ref(false), focus = ref(false)
+const findOpen = ref(false), find = ref(''), replacement = ref(''), linkOpen = ref(false), linkUrl = ref('https://'), linkLabel = ref(''), linkImage = ref(false)
+const history = ref<string[]>([props.draft.content]), cursor = ref(0), interval = ref(30)
+const html = computed(() => props.draft.contentType === 1 ? '' : renderMarkdown(props.draft.content))
+const headings = computed(() => props.draft.content.split('\n').map((line, index) => ({ line, index, match: /^(#{1,6})\s+(.+)/.exec(line) })).filter(x => x.match).slice(0, 100))
+const matches = computed(() => find.value ? props.draft.content.split(find.value).length - 1 : 0)
+let selected = { start: 0, end: 0 }
+function remember() { if (source.value) selected = { start: source.value.selectionStart, end: source.value.selectionEnd } }
+function change(content: string, record = true) {
+  if (record) {
+    const next = history.value.slice(0, cursor.value + 1)
+    if (next[next.length - 1] !== content) next.push(content)
+    if (next.length > 80) next.shift()
+    history.value = next; cursor.value = next.length - 1
+  }
+  emit('change', { content })
+}
+async function edit(before: string, after = '', placeholder = '文字') {
+  if (props.busy || props.draft.contentType === 1) return
+  const next = markdownEdit(props.draft.content, selected.start, selected.end, before, after, placeholder)
+  change(next.text); mode.value = mode.value === 'preview' ? 'split' : mode.value
+  await nextTick(); source.value?.focus(); source.value?.setSelectionRange(next.start, next.end); remember()
+}
+function undo(redo = false) { const index = cursor.value + (redo ? 1 : -1); if (index < 0 || index >= history.value.length) return; cursor.value = index; change(history.value[index], false) }
+function key(e: KeyboardEvent) {
+  remember()
+  if (e.key === 'Tab') { e.preventDefault(); void edit('  ', '', '') }
+  if (!(e.ctrlKey || e.metaKey)) return
+  const k = e.key.toLowerCase()
+  if (['b', 'i', 's', 'f', 'h', 'z', 'y', 'k', 'enter'].includes(k)) e.preventDefault()
+  if (k === 'b') void edit('**', '**')
