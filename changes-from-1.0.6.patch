+/** Only messages actually received while enabled can be retained. Account-scoped, bounded local snapshots. */
+export function createRecallCache(storage: any, accountId: () => string, enabled: () => boolean) {
+  let data: Record<string, any> = {}
+  let loaded: Promise<void> | undefined
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let generation = 0
+  const prefix = (channel: any) => `${accountId()}:${channel.type}:${channel.id}:`
+  const key = (channel: any, id: string) => prefix(channel) + id
+  async function ready() {
+    if (!loaded) {
+      const version = generation
+      loaded = Promise.resolve(storage.load('recall')).then(value => {
+        if (version === generation) data = { ...(value?.messages || {}), ...data }
+      }).catch(() => {})
+    }
+    await loaded
+  }
+  function scheduleSave() {
+    clearTimeout(timer)
+    timer = setTimeout(() => { timer = undefined; void flush() }, 500)
+  }
+  async function flush() {
+    await ready()
+    const cutoff = Date.now() - 7 * 86400000
+    const entries = Object.entries(data).filter(([, m]) => m.cachedAt > cutoff)
+      .sort((a, b) => b[1].cachedAt - a[1].cachedAt).slice(0, 2000)
+    data = Object.fromEntries(entries)
+    await storage.save('recall', { messages: data }).catch(() => {})
+  }
+  function merge(channel: any, incoming: any, previous?: any) {
+    if (!enabled() || !accountId() || !incoming.id) return incoming
+    const saved = data[key(channel, incoming.id)] || previous
+    const recalled = !!(incoming.recalled || saved?.recalled)
+    const retained = recalled && saved && (saved.elements?.length || Object.keys(saved.content || {}).length)
+    const value = retained ? { ...incoming, ...saved, recalled: true, retainedRecall: true } : incoming
+    // Never replace a cached original with a recall tombstone or empty push.
+    if (Object.keys(value.content || {}).length || value.elements?.length) {
