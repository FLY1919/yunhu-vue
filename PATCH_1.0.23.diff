+<script setup lang="ts">
+import { computed, inject, nextTick, onBeforeUnmount, onMounted, ref, watch } from 'vue'
+import Icon from '../console/components/Icon.vue'
+import { clearImageExif, exifLabels, propertyValue, readImageProperties, type ImageProperties } from '../core/image-properties'
+import { saveImageCopy } from '../core/save-image'
+const props = defineProps<{ file?: File; url?: string; mode: 'viewer' | 'attachment'; disabled?: boolean }>()
+const emit = defineEmits<{ (e: 'close'): void; (e: 'use', file: File): void }>()
+const ctx = inject<any>('ctx')
+const source = ref<File>(), info = ref<ImageProperties>(), cleaned = ref<File>()
+const loading = ref(true), busy = ref(false), error = ref(''), status = ref(''), search = ref('')
+const dialog = ref<HTMLElement>(), trigger = document.activeElement as HTMLElement
+let request: AbortController, generation = 0, disposed = false
+const sizeLabel = (size: number) => `${size.toLocaleString()} 字节（${(size / 1024).toFixed(1)} KB）`
+const rows = computed(() => Object.entries(info.value?.exif || {}).flatMap(([group, tags]) =>
+  tags && typeof tags === 'object' ? Object.entries(tags).map(([key, value]) => ({ group, key, label: exifLabels[key] || key, value: propertyValue(value) })) : []
+).filter(row => `${row.group} ${row.key} ${row.label} ${row.value}`.toLowerCase().includes(search.value.toLowerCase())))
+async function load() {
+  const seq = ++generation; request?.abort(); request = new AbortController()
+  loading.value = true; error.value = ''; cleaned.value = undefined; info.value = undefined; source.value = undefined
+  try {
+    let file = props.file
+    if (!file) {
+      const response = await fetch(props.url!, { signal: request.signal })
+      if (!response.ok) throw new Error('读取图片失败 HTTP ' + response.status)
+      const blob = await response.blob()
+      let name = /^(data|blob):/.test(props.url!) ? 'image' : props.url!.split('?')[0].split('/').pop() || 'image'
+      try { name = decodeURIComponent(name) } catch {}
+      file = new File([blob], name, { type: blob.type })
+    }
+    const result = await readImageProperties(file)
+    if (!disposed && seq === generation) { source.value = file; info.value = result }
+  } catch (e: any) { if (!disposed && seq === generation && e.name !== 'AbortError') error.value = e.message || '读取失败' }
+  finally { if (!disposed && seq === generation) loading.value = false }
+}
+watch(() => [props.file, props.url], load, { immediate: true })
+async function clean() {
+  if (!source.value || busy.value || props.disabled) return
+  busy.value = true; error.value = ''; status.value = ''
+  try {
+    const file = await clearImageExif(source.value)
+    const result = await readImageProperties(file)
+    if (disposed) return
+    cleaned.value = file; source.value = file; info.value = result
+    status.value = 'EXIF 已清除并校验。请选择保存副本或用于发送。'
+  } catch (e: any) { if (!disposed) error.value = e.message || '清除失败' }
+  finally { busy.value = false }
