+const state = reactive({ panelOpen: true, list: [{ id: 101, name: '收藏一', url: image }, { id: 102, name: '收藏二', url: image }],
+  packs: [{ id: 1, name: '我创建的', createBy: 'me', items: [{ id: 11, name: '我的表情', url: image }] },
