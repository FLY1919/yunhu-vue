{
  "name": "yunhu-vue",
  "private": true,
  "version": "1.0.42",
  "type": "module",
  "description": "云湖牢大版 · Vue3 + 真 cordis 插件内核 + Satori 协议 + WebDAV 网关（仅供学习交流）",
  "scripts": {
    "dev": "vite",
    "preflight": "node scripts/preflight.mjs",
    "build": "node scripts/preflight.mjs && vite build",
    "preview": "vite preview",
    "serve": "node server.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:chat": "node scripts/test-chat-regressions.mjs",
    "test:kernel": "tsx test-kernel.mjs",
    "test:api": "tsx test.mjs",
    "test:ws": "tsx test-ws.mjs",
    "desktop": "electron electron/main.cjs",
    "desktop:test": "DISPLAY=:99 ELECTRON_DISABLE_SANDBOX=1 electron electron/selftest.cjs --no-sandbox",
    "desktop:dist": "electron-builder --linux AppImage --x64",
    "test:settings": "node scripts/test-settings-regressions.mjs",
    "test:ui": "node scripts/test-ui-regressions.mjs",
    "test:local-files": "node scripts/build-server-bundle.mjs && node scripts/test-local-image-save.mjs",
    "test:features": "node scripts/test-features-regressions.mjs",
    "test:recall": "node --test scripts/test-recall-regressions.mjs && node --no-warnings --experimental-loader ./scripts/test-recall-loader.mjs --test scripts/test-recall-chat.mjs",
    "test:ui-features": "node scripts/test-ui-features.mjs",
    "test:ui-recall": "node scripts/test-ui-recall.mjs",
    "test:ui-stickers": "node scripts/test-ui-sticker-panel.mjs",
    "test:ui-calls": "node scripts/test-ui-private-calls.mjs",
    "test:ui-scroll": "node scripts/test-ui-chat-scroll.mjs",
    "test:ui-bot-buttons": "node scripts/test-ui-bot-buttons.mjs",
    "test:ui-notifications": "node scripts/test-ui-notifications.mjs",
    "test:userbot": "node scripts/test-userbot.mjs",
    "test:ui-userbot": "node scripts/test-ui-userbot.mjs",
    "test:sidecar-userbot": "node scripts/test-sidecar-userbot.mjs",
    "test:group": "node scripts/test-group-create.mjs",
    "test:ui-group": "node scripts/test-ui-group-create.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:ui-security": "node scripts/test-ui-security-layout.mjs",
    "test:ui-resources": "node scripts/test-ui-resources.mjs",
    "test:community": "node scripts/test-community.mjs",
    "test:ui-community": "node scripts/test-ui-community.mjs",
    "test:ui-share-cards": "node scripts/test-ui-share-cards.mjs",
    "test:windows-assets": "node --test scripts/test-windows-assets.mjs",
    "fetch:windows-node": "node scripts/fetch-windows-node.mjs",
    "test:ui-startup": "node scripts/test-ui-startup.mjs",
    "test:maintenance": "node --test scripts/test-maintenance-fixes.mjs",
    "test:ui-uploads": "node scripts/test-ui-upload-fixes.mjs",
    "test:ui-accounts": "node scripts/test-ui-accounts.mjs",
    "test:image-properties": "node scripts/test-image-properties.mjs",
    "test:ui-image-properties": "node scripts/test-ui-image-properties.mjs",
    "test:ui-community-extended": "node scripts/test-ui-community-extended.mjs",
    "test:sidecar-port": "node scripts/build-server-bundle.mjs && node scripts/test-sidecar-port.mjs",
    "test:image-delivery": "node scripts/test-image-delivery.mjs",
    "test:editor": "node scripts/test-editor-core.mjs",
    "test:ui-editor": "node scripts/test-ui-editor-rebuild.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@jodit/image-editor": "0.2.5",
    "@satorijs/core": "^4.6.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/vue-3": "3.32.2",
    "@types/qrcode": "^1.5.6",
    "cordis": "^3.18.1",
    "cropperjs": "^1.7.0",
    "dompurify": "^3.4.16",
    "exifr": "^7.1.3",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "katex": "0.16.22",
    "livekit-client": "2.23.0",
    "marked": "^18.0.14",
    "qrcode": "^1.5.4",
    "schemastery": "^3.18.0",
    "shiki": "2.5.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.13"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.yhchat.kobe",
    "productName": "云湖牢大版",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "build/tray.png",
      "build/installer-sidebar.bmp",
      "package.json",
      "!**/node_modules/**",
      "!node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "artifactName": "yunhulaoda-${version}-linux-${arch}.AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "yunhulaoda-${version}-windows-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "yunhulaoda-${version}-windows-${arch}-setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "executableName": "yunhulaoda",
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "yunhulaoda-${version}-macos-${arch}.dmg",
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns"
    },
    "compression": "maximum",
    "afterPack": "./scripts/afterPack-slim.cjs"
  }
}
