{
  "name": "yunhu-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "云湖第三方 Web 客户端 · Vue3 + 真 cordis 插件内核 + Satori 协议 + WebDAV 网关（仅供学习交流）",
  "scripts": {
    "dev": "vite",
    "preflight": "node scripts/preflight.mjs",
    "build": "node scripts/preflight.mjs && vite build",
    "preview": "vite preview",
    "serve": "node server.ts",
    "typecheck": "vue-tsc --noEmit",
