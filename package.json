{
  "name": "yunhu-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "云湖第三方 Web 客户端 · Vue3 + 真 cordis 插件内核 + Satori 协议 + WebDAV 网关（仅供学习交流）",
  "scripts": {
    "dev": "vite",
    "preflight": "node scripts/preflight.mjs",
    "build": "node scripts/preflight.mjs && vite build",
    "preview": "vite preview",
    "serve": "node server.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:kernel": "tsx test-kernel.mjs",
    "test:api": "tsx test.mjs",
    "test:ws": "tsx test-ws.mjs",
    "desktop": "electron electron/main.cjs",
    "desktop:test": "DISPLAY=:99 ELECTRON_DISABLE_SANDBOX=1 electron electron/selftest.cjs --no-sandbox",
    "desktop:dist": "electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@satorijs/core": "^4.6.0",
    "cordis": "^3.18.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "schemastery": "^3.18.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "js-yaml": "^5.4.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.fly1919.yunhu",
    "productName": "云湖客户端",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "artifactName": "yunhu-client-${version}-x64.AppImage"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "yunhu-client-${version}-setup-x64.exe",
      "icon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "executableName": "yunhu-client",
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "yunhu-client-${version}-x64.dmg",
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns"
    }
  }
}
