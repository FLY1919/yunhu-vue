    "marked": "^18.0.14",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "js-yaml": "^5.4.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4"
  }
