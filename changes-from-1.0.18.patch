+import assert from 'node:assert/strict'
+import { createServer } from 'vite'
+import vue from '@vitejs/plugin-vue'
+const { chromium } = await import(process.env.PLAYWRIGHT_MODULE || 'playwright')
+const server = await createServer({root:process.cwd(),configFile:false,plugins:[vue()],server:{host:'127.0.0.1',port:0},logLevel:'error'})
+await server.listen()
+const browser=await chromium.launch({headless:true,executablePath:process.env.CHROMIUM_EXECUTABLE||undefined,args:['--no-sandbox','--disable-dev-shm-usage','--disable-gpu']})
+const page=await browser.newPage({viewport:{width:1280,height:850}}), errors=[]
+page.on('pageerror',e=>errors.push(e.message))
+try {
+  await page.goto(`http://127.0.0.1:${server.httpServer.address().port}/scripts/ui-fixture/community.html`)
+  await page.getByRole('button',{name:'进入板块 笔记 / 随感',exact:true}).waitFor()
+  assert.equal(await page.locator('.board-row').count(),5)
+  await page.waitForFunction(()=>document.querySelectorAll('.community-avatar img').length===4)
+  await page.getByRole('button',{name:'进入板块 笔记 / 随感',exact:true}).click()
+  await page.locator('.post-card').first().waitFor()
+  assert.equal(await page.locator('.post-card').count(),30)
+  assert.equal(await page.locator('.community-dialog[open]').count(),0)
+  if(process.env.COMMUNITY_QA_DIR) await page.screenshot({animations:'disabled',path:process.env.COMMUNITY_QA_DIR+'/community-dark.png'})
+  await page.evaluate(()=>document.documentElement.dataset.theme='light')
+  if(process.env.COMMUNITY_QA_DIR) await page.screenshot({animations:'disabled',path:process.env.COMMUNITY_QA_DIR+'/community-light.png'})
+  await page.getByRole('button',{name:'加载更多文章',exact:true}).click()
+  await page.waitForFunction(()=>document.querySelectorAll('.post-card').length===31)
+  await page.getByText('已显示全部文章',{exact:true}).waitFor()
+  await page.locator('.post-card').first().click()
+  await page.locator('.article-detail h1').filter({hasText:'物理光学：从观察开始'}).waitFor()
+  assert.equal(await page.evaluate(()=>window.evil),undefined)
+  assert.equal(await page.locator('.article-prose script, .article-prose [onerror]').count(),0)
+  await page.getByRole('button',{name:'文章列表',exact:true}).click()
+  assert.equal(await page.locator('.post-card').count(),31)
+  await page.getByRole('button',{name:'管理',exact:true}).click()
+  await page.getByRole('dialog',{name:'管理板块'}).waitFor()
+  await page.getByLabel('板块名称',{exact:true}).fill('新的笔记')
+  await page.locator('input[type=file]').setInputFiles({name:'avatar.png',mimeType:'image/png',buffer:Buffer.from('fake image')})
+  await page.waitForFunction(()=>window.__community.ctx.community.state.uploading===false)
+  await page.evaluate(()=>window.__community.fail.edit=true)
+  await page.getByRole('button',{name:'保存信息',exact:true}).click()
+  await page.waitForFunction(()=>window.__community.ctx.community.state.saving===false)
+  assert.equal(await page.getByLabel('板块名称',{exact:true}).inputValue(),'新的笔记')
+  assert.equal(await page.getByRole('dialog',{name:'管理板块'}).isVisible(),true)
+  await page.evaluate(()=>window.__community.fail.edit=false)
+  await page.getByRole('button',{name:'保存信息',exact:true}).click()
+  await page.getByRole('dialog').waitFor({state:'hidden'})
+  await page.locator('.reader-title h3').filter({hasText:'新的笔记'}).waitFor()
+  await page.getByRole('button',{name:'关联群聊',exact:true}).click()
+  await page.getByText('物理学习交流',{exact:true}).waitFor()
+  await page.getByLabel('绑定群聊',{exact:true}).fill('888')
+  await page.getByRole('button',{name:'绑定',exact:true}).click()
+  await page.waitForFunction(()=>window.__community.calls.some(x=>x[0]==='bind'&&x[2]==='888'))
+  await page.waitForFunction(()=>!window.__community.ctx.community.state.binding)
+  await page.keyboard.press('Escape');await page.getByRole('dialog').waitFor({state:'hidden'})
+  await page.getByRole('button',{name:'进入板块 物理研习室',exact:true}).click()
